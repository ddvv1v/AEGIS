{
  "name": "aegis-boot",
  "version": "1.2.0",
  "description": "AEGIS 安全终端开机动画：独立的登录序列开屏，支持配色、口令、标题与语音设置",
  "type": "module",
  "main": "lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "splash-screen",
    "boot-animation",
    "login",
    "theme"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddvv1v/AEGIS.git"
  },
  "homepage": "https://github.com/ddvv1v/AEGIS#readme",
  "bugs": {
    "url": "https://github.com/ddvv1v/AEGIS/issues"
  },

  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT"
}
